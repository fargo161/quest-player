{
  "name": "quest-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "qr": "node --env-file-if-exists=.env scripts/qr.js",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup-restore.js",
    "cleanup": "node --env-file-if-exists=.env scripts/cleanup.js",
    "db:local": "node --env-file-if-exists=.env scripts/local-pg.js",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "playwright": "^1.63.0",
    "smtp-server": "^3.19.9",
    "supertest": "^7.2.2"
  }
}
